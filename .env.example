# ── Сховище вкладень ──────────────────────────────────────────────────────────
# Куди складати файли, прикріплені до карток.
#
# Диск контейнера на Railway ефемерний: без примонтованого тому вкладення
# зникають на кожному деплої, а посилання в картках лишаються битими.
#
# На Railway: створіть Volume і прикріпіть до сервісу — RAILWAY_VOLUME_MOUNT_PATH
# підставиться сам, і нічого задавати тут не треба.
# Якщо том змонтовано інакше — вкажіть корінь явно (файли підуть у <шлях>/uploads):
# UPLOADS_DIR=/data

# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен бота та ID чату для щоденних звітів о 08:00
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Ключ для генерації ШІ-звітів
GEMINI_API_KEY=

# ── Firebase Firestore (хмарне сховище) ───────────────────────────────────────
# Отримати на: console.firebase.google.com
# Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Секретний ключ для JWT токенів. Змінити в production!
JWT_SECRET=pawell-crm-secret-change-me

# ── KeepInCRM ─────────────────────────────────────────────────────────────────
# API-ключ: keepincrm.com → Налаштування → API → Згенерувати ключ
KEEPINCRM_API_KEY=
# Поддомен вашого акаунту (тільки субдомен без .keepincrm.com)
KEEPINCRM_SUBDOMAIN=
# Інтервал синхронізації в хвилинах (за замовчуванням: 30)
KEEPINCRM_SYNC_INTERVAL_MINUTES=30
