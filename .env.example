# ── Сховище вкладень ──────────────────────────────────────────────────────────
# Куди складати файли, прикріплені до карток.
#
# Диск контейнера на Railway ефемерний: без примонтованого тому вкладення
# зникають на кожному деплої, а посилання в картках лишаються битими.
#
# На Railway: створіть Volume і прикріпіть до сервісу — RAILWAY_VOLUME_MOUNT_PATH
# підставиться сам, і нічого задавати тут не треба.
# Якщо том змонтовано інакше — вкажіть корінь явно (файли підуть у <шлях>/uploads):
# UPLOADS_DIR=/data

# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен бота та ID чату для щоденних звітів о 08:00
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Коли видаляти надіслані ботом оголошення (перерви тощо), cron за Києвом. За замовчуванням 21:00
TELEGRAM_CLEANUP_CRON=0 21 * * *

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Ключ для генерації ШІ-звітів, оцінки задач і (за замовчуванням) асистентів
GEMINI_API_KEY=

# ── Модель асистентів: хмара чи власний ПК ────────────────────────────────────
# Керує лише асистентами (загальним і проєктним). Звіти й оцінка задач лишаються на Gemini.
# gemini (за замовчуванням) або local
LLM_PROVIDER=gemini
#
# Для local — будь-який OpenAI-сумісний сервер (Ollama, LM Studio, llama.cpp, vLLM):
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434/v1     # Ollama; це адреса, видима З СЕРВЕРА CRM
# LLM_MODEL=qwen3:14b
# LLM_API_KEY=                               # якщо перед моделлю стоїть авторизація
# LLM_EXTRA_HEADERS={"CF-Access-Client-Id":"…","CF-Access-Client-Secret":"…"}   # Cloudflare Access
# LLM_EXTRA_BODY={"reasoning_effort":"none"} # вимкнути «роздуми» Qwen3 — швидше в рази
# LLM_TIMEOUT_MS=180000                      # на один виклик моделі
# LLM_TEMPERATURE=0.2
# LLM_HISTORY_MESSAGES=10                    # скільки повідомлень історії слати моделі
# LLM_FILE_PAGE_CHARS=6000                   # розмір сторінки файла (контекст малий)
# Якщо ПК вимкнено чи недоступний — відповісти через Gemini (дані підуть у хмару!)
# LLM_FALLBACK_GEMINI=true

# ── Firebase Firestore (хмарне сховище) ───────────────────────────────────────
# Отримати на: console.firebase.google.com
# Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Секретний ключ для JWT токенів. Змінити в production!
JWT_SECRET=pawell-crm-secret-change-me

# ── KeepInCRM ─────────────────────────────────────────────────────────────────
# API-ключ: keepincrm.com → Налаштування → API → Згенерувати ключ
KEEPINCRM_API_KEY=
# Поддомен вашого акаунту (тільки субдомен без .keepincrm.com)
KEEPINCRM_SUBDOMAIN=
# Інтервал синхронізації в хвилинах (за замовчуванням: 30)
KEEPINCRM_SYNC_INTERVAL_MINUTES=30

# ── Частота контакту (дзвінки + завдання-контакти) ────────────────────────────
# Спільний секрет для приймача дзвінків POST /api/keepincrm/call-webhook.
# KeepInCRM не має нашого JWT, тож тригер передає цей токен — у заголовку
# X-Webhook-Token, у ?token=... або полем token у тілі. Поки не заданий, роут
# закритий: відкритий приймач дозволив би накрутити статистику дзвінків.
# Налаштування в KeepInCRM: Налаштування → Керування → Тригери → тип
# «Робота з дзвінками» → дія «Відправка Webhook».
KEEPINCRM_WEBHOOK_SECRET=
# Які категорії завдань вважати контактом — точний список через кому
# (напр. «Дзвінок,Зустріч»). Порожньо = за зразком назви: дзвінок, звонок,
# call, телефон, зустріч, meeting, контакт, переговори.
KEEPINCRM_CONTACT_TASK_CATEGORIES=

# Web Push: ключі генеруються командою  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Google Calendar (міти з Meet + дзеркало задач і подій) ────────────────────
# Кожен користувач підключає СВІЙ акаунт Google кнопкою в кабінеті.
#
# Налаштування (один раз, адміністратором):
#  1. console.cloud.google.com → створити проєкт → «APIs & Services» → увімкнути «Google Calendar API».
#  2. «OAuth consent screen»: тип External, додати scope .../auth/calendar.events.
#     ВАЖЛИВО: переведіть застосунок зі стану «Testing» у «In production». У Testing
#     Google анулює токени через 7 днів і календар «відпаде» в усіх. Верифікація
#     потрібна лише для понад 100 користувачів; до того буде екран «Google не перевірив
#     цей застосунок» — це нормально для внутрішнього інструменту.
#  3. «Credentials» → Create OAuth client ID → тип «Web application».
#     У «Authorized redirect URIs» вкажіть адресу callback (її також показує кабінет адміну):
#       https://ВАШ-ДОМЕН/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Адреса callback явно. Якщо сервер стоїть за проксі й адреса визначається неправильно — задайте її.
# GOOGLE_REDIRECT_URI=https://crm.example.com/api/google/callback
# Адреса застосунку для посилань «Відкрити в CRM» у подіях календаря
# PUBLIC_APP_URL=https://crm.example.com
# Ключ шифрування refresh-токенів у базі. Якщо не задано — береться JWT_SECRET.
# УВАГА: зміна цього ключа (чи JWT_SECRET) робить збережені токени нечитабельними —
# усім доведеться підключити Google заново.
# GOOGLE_TOKEN_KEY=
