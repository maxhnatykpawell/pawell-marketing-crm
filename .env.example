# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен бота та ID чату для щоденних звітів о 08:00
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Ключ для генерації ШІ-звітів
GEMINI_API_KEY=

# ── Firebase Firestore (хмарне сховище) ───────────────────────────────────────
# Отримати на: console.firebase.google.com
# Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Секретний ключ для JWT токенів. Змінити в production!
JWT_SECRET=pawell-crm-secret-change-me

# ── KeepInCRM ─────────────────────────────────────────────────────────────────
# API-ключ: keepincrm.com → Налаштування → API → Згенерувати ключ
KEEPINCRM_API_KEY=
# Поддомен вашого акаунту (тільки субдомен без .keepincrm.com)
KEEPINCRM_SUBDOMAIN=
# Інтервал синхронізації в хвилинах (за замовчуванням: 30)
KEEPINCRM_SYNC_INTERVAL_MINUTES=30
